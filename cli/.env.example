# SecurePush CLI — environment variables
# Copy this to .env and fill in whichever provider(s) you're using.
# Local/Ollama mode needs none of these.

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Only used if you choose Ollama as your provider (defaults shown)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Only used in SecurePush Cloud mode
SECUREPUSH_DASHBOARD_URL=http://localhost:3000

# Hindsight memory (Cloud or local)
HINDSIGHT_HOST=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
